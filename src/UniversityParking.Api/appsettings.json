{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Textract": {
    "Region": "us-east-1",
    "TimeoutSeconds": 15
  },
  "UniversityIntegrations": {
    "Universities": []
  },
  "StudentRegistration": {
    "AutoApprove": false
  },
  "Jwt": {
    "Issuer": "UniversityParking.Api",
    "Audience": "UniversityParking.Mobile",
    "ExpirationMinutes": 480
  },
  "Parking": {
    "TimeZone": "America/Bogota"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/private-files",
    "SignedUrlExpirationMinutes": 5
  },
  "DocumentOcr": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  }
}

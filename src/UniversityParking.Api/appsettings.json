{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "UniversityParking.Api",
    "Audience": "UniversityParking.Mobile",
    "ExpirationMinutes": 480
  },
  "Parking": {
    "TimeZone": "America/Bogota"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/private-files",
    "SignedUrlExpirationMinutes": 5
  },
  "Swagger": {
    "Enabled": false
  }
}



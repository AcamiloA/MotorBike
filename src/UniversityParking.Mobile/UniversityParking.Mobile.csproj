<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>UniversityParking.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>MOTOBIKE PARK</ApplicationTitle>
    <ApplicationId>com.motobikepark.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApiBaseUrl Condition="'$(ApiBaseUrl)' == '' and '$(Configuration)' == 'Debug'">http://10.0.2.2:5197/</ApiBaseUrl>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#101114" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101114" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniversityParking.Contracts\UniversityParking.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ApiBaseUrl</_Parameter1><_Parameter2>$(ApiBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="ValidateApiBaseUrl" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!$([System.String]::Copy('$(ApiBaseUrl)').StartsWith('https://'))" Text="Release requiere -p:ApiBaseUrl=https://servidor/ con una URL HTTPS real." />
  </Target>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\..\src\UniversityParking.Mobile\Core\*.cs" Link="MobileCore\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UniversityParking.Api\UniversityParking.Api.csproj" />
    <ProjectReference Include="..\..\src\UniversityParking.Infrastructure\UniversityParking.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\UniversityParking.Application\UniversityParking.Application.csproj" />
    <ProjectReference Include="..\..\src\UniversityParking.Contracts\UniversityParking.Contracts.csproj" />
  </ItemGroup>

</Project>

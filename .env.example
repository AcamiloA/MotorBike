# Ejecutar scripts/initialize-docker.ps1 para generar secretos locales.
POSTGRES_PASSWORD=
JWT_KEY=
API_PORT=8080
SWAGGER_ENABLED=false
SEED_ENABLED=false
DEMO_ENABLED=false
ALLOW_DEMO_IN_PRODUCTION=false
DEMO_PASSWORD=

# OCR opcional; la evidencia sigue siendo obligatoria.
DocumentOcr__Enabled=false

# Correo deshabilitado por defecto. Configurar solo mediante secretos del entorno.
EmailDelivery__Enabled=false
EmailDelivery__Provider=Smtp
Smtp__Host=
Smtp__Port=587
Smtp__UseStartTls=true
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=MotorBike Park
